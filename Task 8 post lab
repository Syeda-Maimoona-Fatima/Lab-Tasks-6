#include <stdio.h>
int main() 
{
    float prices[5],total=0, discount=0, final;
    int i;
    for (i=0; i<5; i++) 
    {
        printf("Enter price of product %d: ", i + 1);
        scanf("%f", &prices[i]);
        total +=prices[i];
    }
    if (total>10000)
        discount= total* 0.10;
    final= total-discount;
    printf("Original total is %.2f", total);
    printf("\nDiscount: %.2f", discount);
    printf("\nFinal amount is %.2f", final);
    return 0;
}
