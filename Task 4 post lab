#include <stdio.h>
int main() 
{
    float price,final ,total=0,discount=0;
    int extra;
    do 
    {
        printf("Enter item price ");
        scanf("%f", &price);
        total+=price;
        printf("Add another item? (1=Yes, 0=No) ");
        scanf("%d", &extra);
    } while (extra== 1);
    if (total >10000)
    {
        discount = total*0.10;
    } 
    printf("\nTotal price: %.2f", total);
    printf("\nDiscount: %.2f", discount);
    final=total-discount;
    printf("\n Final amount: %.2f", final);
    return 0;
}
