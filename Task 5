#include <stdio.h>

int main()
{
    float temp, total= 0;
    int i, count= 0;
    for (i=1; i<=7; i++)
    {
        printf("Enter temperature of day %d ", i);
        scanf("%f", &temp);
        total= total+temp;
        if (temp > 100)
            count++;
    }
    printf("Total temperature: %f",total);
    printf("\nNumber of temperatures greater than 100 are %d",count);
    return 0;
}
